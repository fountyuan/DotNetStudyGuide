### 5. Filters/GlobalExceptionFilter.cs

```csharp
using Microsoft.AspNetCore.Mvc;
using Microsoft.AspNetCore.Mvc.Filters;
using Fountain.Service.Identity.Application.DTOs.Common;
using Fountain.Service.Identity.Domain.Exceptions;

namespace Fountain.Service.Identity.Api.Filters;

/// <summary>
/// 全局异常过滤器
/// </summary>
public class GlobalExceptionFilter : IExceptionFilter
{
    private readonly ILogger<GlobalExceptionFilter> _logger;

    public GlobalExceptionFilter(ILogger<GlobalExceptionFilter> logger)
    {
        _logger = logger;
    }

    public void OnException(ExceptionContext context)
    {
        var exception = context.Exception;
        var response = ApiResponse<object>.Fail("服务器内部错误", "INTERNAL_ERROR");

        switch (exception)
        {
            case IdentityDomainException domainEx:
                response = ApiResponse<object>.Fail(domainEx.Message, domainEx.Code);
                context.Result = new BadRequestObjectResult(response);
                break;

            case UnauthorizedAccessException:
                response = ApiResponse<object>.Fail(exception.Message, "UNAUTHORIZED");
                context.Result = new UnauthorizedObjectResult(response);
                break;

            case InvalidOperationException:
                response = ApiResponse<object>.Fail(exception.Message, "INVALID_OPERATION");
                context.Result = new BadRequestObjectResult(response);
                break;

            case ArgumentException:
            case ArgumentNullException:
                response = ApiResponse<object>.Fail(exception.Message, "INVALID_ARGUMENT");
                context.Result = new BadRequestObjectResult(response);
                break;

            default:
                _logger.LogError(exception, "未处理的异常: {Message}", exception.Message);
                context.Result = new ObjectResult(response) { StatusCode = 500 };
                break;
        }

        context.ExceptionHandled = true;
    }
}
