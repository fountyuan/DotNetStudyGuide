### 6. Filters/ApiResultFilter.cs

```csharp
using Microsoft.AspNetCore.Mvc;
using Microsoft.AspNetCore.Mvc.Filters;
using Fountain.Service.Identity.Application.DTOs.Common;

namespace Fountain.Service.Identity.Api.Filters;

/// <summary>
/// API 结果包装过滤器
/// 统一包装响应格式
/// </summary>
public class ApiResultFilter : IActionFilter
{
    public void OnActionExecuting(ActionExecutingContext context)
    {
    }

    public void OnActionExecuted(ActionExecutedContext context)
    {
        if (context.Result == null)
            return;

        // 如果已经是 ApiResponse 格式，不再包装
        if (context.Result is ObjectResult objectResult && objectResult.Value is ApiResponse<object>)
            return;

        // 如果已经是 FileResult 或其他特殊结果，不包装
        if (context.Result is FileResult || context.Result is StatusCodeResult)
            return;

        // 包装成功响应
        if (context.Result is ObjectResult successResult)
        {
            var wrappedResult = ApiResponse<object>.Ok(successResult.Value, "操作成功");
            context.Result = new ObjectResult(wrappedResult)
            {
                StatusCode = successResult.StatusCode ?? 200
            };
        }
        else if (context.Result is JsonResult jsonResult)
        {
            var wrappedResult = ApiResponse<object>.Ok(jsonResult.Value, "操作成功");
            context.Result = new ObjectResult(wrappedResult)
            {
                StatusCode = 200
            };
        }
        else if (context.Result is ContentResult contentResult)
        {
            var wrappedResult = ApiResponse<object>.Ok(contentResult.Content, "操作成功");
            context.Result = new ObjectResult(wrappedResult)
            {
                StatusCode = contentResult.StatusCode ?? 200
            };
        }
    }
}
