using Microsoft.AspNetCore.Authorization;
using Microsoft.AspNetCore.Mvc;
using Fountain.Service.Identity.Application.Commands.Auth;
using Fountain.Service.Identity.Application.DTOs.Auth;
using Fountain.Service.Identity.Application.DTOs.Common;
using Fountain.Service.Identity.Application.Queries.Menus;
using Fountain.Service.Identity.Application.Common.Interfaces;

namespace Fountain.Service.Identity.Api.Controllers;

/// <summary>
/// 认证控制器
/// </summary>
[AllowAnonymous]
public class AuthController : BaseApiController
{
    private readonly ICurrentUser _currentUser;
    private readonly IHttpContextAccessor _httpContextAccessor;

    public AuthController(ICurrentUser currentUser, IHttpContextAccessor httpContextAccessor)
    {
        _currentUser = currentUser;
        _httpContextAccessor = httpContextAccessor;
    }

    /// <summary>
    /// 用户登录
    /// </summary>
    /// <param name="request">登录请求</param>
    /// <returns>登录响应</returns>
    [HttpPost("login")]
    [ProducesResponseType(typeof(ApiResponse<LoginResponseDto>), 200)]
    [ProducesResponseType(typeof(ApiResponse<object>), 400)]
    public async Task<ActionResult<ApiResponse<LoginResponseDto>>> Login([FromBody] LoginDto request)
    {
        var ipAddress = _httpContextAccessor.HttpContext?.Connection.RemoteIpAddress?.ToString();
        var userAgent = _httpContextAccessor.HttpContext?.Request.Headers["User-Agent"].ToString();

        var command = new LoginCommand
        {
            Data = request,
            IpAddress = ipAddress,
            UserAgent = userAgent
        };

        var result = await Mediator.Send(command);
        return Success(result, "登录成功");
    }

    /// <summary>
    /// 刷新Token
    /// </summary>
    /// <param name="request">刷新Token请求</param>
    /// <returns>新的Token</returns>
    [HttpPost("refresh")]
    [ProducesResponseType(typeof(ApiResponse<LoginResponseDto>), 200)]
    public async Task<ActionResult<ApiResponse<LoginResponseDto>>> RefreshToken([FromBody] RefreshTokenRequest request)
    {
        var ipAddress = _httpContextAccessor.HttpContext?.Connection.RemoteIpAddress?.ToString();

        var command = new RefreshTokenCommand
        {
            RefreshToken = request.RefreshToken,
            IpAddress = ipAddress
        };

        var result = await Mediator.Send(command);
        return Success(result, "Token刷新成功");
    }

    /// <summary>
    /// 用户登出
    /// </summary>
    [HttpPost("logout")]
    [Authorize]
    [ProducesResponseType(typeof(ApiResponse<object>), 200)]
    public async Task<ActionResult<ApiResponse<object>>> Logout([FromBody] LogoutRequest? request)
    {
        var command = new LogoutCommand
        {
            UserId = _currentUser.Id,
            RefreshToken = request?.RefreshToken ?? string.Empty
        };

        await Mediator.Send(command);
        return Success("登出成功");
    }

    /// <summary>
    /// 获取当前用户信息
    /// </summary>
    [HttpGet("current-user")]
    [Authorize]
    [ProducesResponseType(typeof(ApiResponse<CurrentUserDto>), 200)]
    public async Task<ActionResult<ApiResponse<CurrentUserDto>>> GetCurrentUser()
    {
        var user = new CurrentUserDto
        {
            Id = _currentUser.Id,
            Username = _currentUser.UserName ?? string.Empty,
            Nickname = _currentUser.Name,
            Email = _currentUser.Email,
            Phone = _currentUser.Phone,
            OrgId = _currentUser.OrgId,
            Permissions = _currentUser.GetPermissions()
        };

        // 获取用户菜单
        var menus = await Mediator.Send(new GetUserMenusQuery { UserId = _currentUser.Id });
        user.Menus = menus;

        return Success(user, "获取成功");
    }

    /// <summary>
    /// 获取用户菜单
    /// </summary>
    [HttpGet("menus")]
    [Authorize]
    [ProducesResponseType(typeof(ApiResponse<List<MenuTreeDto>>), 200)]
    public async Task<ActionResult<ApiResponse<List<MenuTreeDto>>>> GetMenus()
    {
        var result = await Mediator.Send(new GetUserMenusQuery { UserId = _currentUser.Id });
        return Success(result, "获取成功");
    }

    /// <summary>
    /// 获取用户权限
    /// </summary>
    [HttpGet("permissions")]
    [Authorize]
    [ProducesResponseType(typeof(ApiResponse<List<string>>), 200)]
    public IActionResult GetPermissions()
    {
        var permissions = _currentUser.GetPermissions();
        return Success(permissions, "获取成功");
    }
}

/// <summary>
/// 刷新Token请求
/// </summary>
public class RefreshTokenRequest
{
    public string RefreshToken { get; set; } = string.Empty;
}

/// <summary>
/// 登出请求
/// </summary>
public class LogoutRequest
{
    public string? RefreshToken { get; set; }
}

/// <summary>
/// 当前用户信息
/// </summary>
public class CurrentUserDto
{
    public long Id { get; set; }
    public string Username { get; set; } = string.Empty;
    public string? Nickname { get; set; }
    public string? Email { get; set; }
    public string? Phone { get; set; }
    public long OrgId { get; set; }
    public List<string> Permissions { get; set; } = new();
    public List<MenuTreeDto> Menus { get; set; } = new();
}
