    [HttpGet]
    [ProducesResponseType(typeof(ApiResponse<PaginatedResult<UserListDto>>), 200)]
    public async Task<ActionResult<ApiResponse<PaginatedResult<UserListDto>>>> GetList(
        [FromQuery] int pageIndex = 1,
        [FromQuery] int pageSize = 20,
        [FromQuery] string? keyword = null,
        [FromQuery] long? orgId = null,
        [FromQuery] string? status = null)
    {
        var query = new GetUserListQuery
        {
            PageIndex = pageIndex,
            PageSize = pageSize,
            Keyword = keyword,
            OrgId = orgId,
            Status = status
        };

        var result = await Mediator.Send(query);
        return Success(result, "获取成功");
    }

    /// <summary>
    /// 根据ID获取用户
    /// </summary>
    [HttpGet("{id}")]
    [ProducesResponseType(typeof(ApiResponse<UserDto>), 200)]
    [ProducesResponseType(typeof(ApiResponse<object>), 404)]
    public async Task<ActionResult<ApiResponse<UserDto>>> GetById(long id)
    {
        var query = new GetUserByIdQuery { Id = id };
        var result = await Mediator.Send(query);

        if (result == null)
            return NotFoundResponse($"用户 {id} 不存在");

        return Success(result, "获取成功");
    }

    /// <summary>
    /// 创建用户
    /// </summary>
    [HttpPost]
    [ProducesResponseType(typeof(ApiResponse<UserDto>), 200)]
    [ProducesResponseType(typeof(ApiResponse<object>), 400)]
    public async Task<ActionResult<ApiResponse<UserDto>>> Create([FromBody] CreateUserDto dto)
    {
        var command = new CreateUserCommand { Data = dto };
        var result = await Mediator.Send(command);
        return Success(result, "创建成功");
    }

    /// <summary>
    /// 更新用户
    /// </summary>
    [HttpPut("{id}")]
    [ProducesResponseType(typeof(ApiResponse<UserDto>), 200)]
    [ProducesResponseType(typeof(ApiResponse<object>), 400)]
    [ProducesResponseType(typeof(ApiResponse<object>), 404)]
    public async Task<ActionResult<ApiResponse<UserDto>>> Update(long id, [FromBody] UpdateUserDto dto)
    {
        var command = new UpdateUserCommand { Id = id, Data = dto };
        var result = await Mediator.Send(command);

        if (result == null)
            return NotFoundResponse($"用户 {id} 不存在");

        return Success(result, "更新成功");
    }

    /// <summary>
    /// 删除用户
    /// </summary>
    [HttpDelete("{id}")]
    [ProducesResponseType(typeof(ApiResponse<bool>), 200)]
    [ProducesResponseType(typeof(ApiResponse<object>), 404)]
    public async Task<ActionResult<ApiResponse<bool>>> Delete(long id)
    {
        var command = new DeleteUserCommand { Id = id };
        var result = await Mediator.Send(command);
        return Success(result, "删除成功");
    }

    /// <summary>
    /// 修改密码
    /// </summary>
    [HttpPost("{id}/change-password")]
    [ProducesResponseType(typeof(ApiResponse<bool>), 200)]
